{
  "name": "mcp-gateway",
  "version": "0.1.0",
  "description": "MCP gateway with RBAC for enterprise tool access",
  "type": "module",
  "bin": {
    "mcp-gateway": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "gateway:login": "tsx src/index.ts login",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && eslint . --ext .ts --max-warnings 0"
  },
  "keywords": [
    "mcp",
    "gateway",
    "rbac",
    "enterprise"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "firebase-admin": "^13.8.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
